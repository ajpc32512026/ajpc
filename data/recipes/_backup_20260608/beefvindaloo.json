            "notes": "cut into 2.5 cm cubes"
        },
        {
            "quantity": "45",
            "unit": "ml",
            "item": "Vegetable Oil"
        },
        {
            "quantity": "300",
            "unit": "g",
            "item": "Brown Onion",
            "notes": "chopped"
        },
        {
            "quantity": "3",
