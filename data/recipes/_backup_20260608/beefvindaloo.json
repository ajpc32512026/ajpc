            "unit": "g",
            "item": "Turmeric"
        },
        {
            "quantity": "5",
            "unit": "g",
            "item": "Red Chilli Powder"
        },
        {
            "quantity": "250",
            "unit": "g",
            "item": "Tomatoes",
            "notes": "chopped"
        },
        {
            "quantity": "40",
            "unit": "g",
            "item": "Tomato Paste"
        },
        {
            "quantity": "30",
            "unit": "ml",
            "item": "White Vinegar"
        },
        {
            "quantity": "5",
            "unit": "g",
            "item": "White Sugar"
        },
        {
            "quantity": "250",
            "unit": "ml",
            "item": "Hot Water"
        },
        {
            "quantity": "5",
            "unit": "g",
            "item": "Coriander (Fresh)",
            "notes": "for garnish"
        },
        {
            "item": "Salt & Pepper",
            "toTaste": true,
            "notes": "Don't add too much all at once — you can't take it out once it's in."
        }
    ],
    "method": [
        {
            "step": 1,
            "instruction": "Prepare 1 batch of [[vindaloopaste|Vindaloo Paste]] according to the recipe. Set aside."
        },
        {
            "step": 2,
            "instruction": "Place beef in a large bowl. Add the vindaloo paste and toss to coat evenly. Cover and marinate at least 1 hour at room temperature, or refrigerate overnight for deeper flavour."
        },
        {
            "step": 3,
            "instruction": "Heat vegetable oil in a large heavy-based pot over medium-high heat. Add onions and sauté 2–3 minutes until soft. Add garlic and sauté 1 minute until fragrant."
        },
        {
            "step": 4,
            "instruction": "Add turmeric, chilli powder, chopped tomatoes, tomato paste, and white vinegar. Cook 2–3 minutes until tomatoes break down."
        },
        {
            "step": 5,
            "instruction": "Add marinated beef and sugar. Season with salt. Cook for 10 minutes, stirring occasionally."
        },
        {
            "step": 6,
            "instruction": "Pour in hot water, bring to the boil, reduce heat to low, cover, and simmer for 1 hour or until beef is tender and sauce has thickened."
        },
        {
            "step": 7,
            "instruction": "If sauce is too thin, uncover and simmer for a further 5–10 minutes to reduce."
        },
        {
            "step": 8,
            "instruction": "Garnish with fresh coriander and serve with steamed rice."
        }
    ],
    "notes": [
        {
            "type": "substitution",
            "title": "Vinegar Substitute",
            "content": "You can substitute white vinegar with apple cider vinegar, rice wine vinegar, or lemon juice for similar acidity and flavour."
        },
        {
            "type": "technique",
            "title": "Overnight Marinade",
            "content": "For the deepest flavour, marinate the beef overnight in the refrigerator. The vinegar and spices will tenderise the meat while infusing it with flavour."
        },
        {
            "type": "technique",
            "title": "Paste Yield",
            "content": "The vindaloo paste recipe yields approximately 80–100 g — exactly the right amount for 1 kg of beef. Use the full batch."
        }
    ],
