{
    "id": "beefvindaloo",
    "title": "Beef Vindaloo",
    "emoji": "🔥",
    "category": "Dinner",
    "description": "An authentic, fiery, melt-in-your-mouth beef curry that doesn't muck around.",
    "prepTime": "15 min",
    "cookTime": "1 hr",
    "totalTime": "1 hr 15 min",
    "servings": "4 servings",
    "difficulty": "Intermediate",
