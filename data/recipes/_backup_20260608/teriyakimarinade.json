    "method": [
        {
            "step": 1,
            "instruction": "Combine soy sauce, mirin, sugar, and garlic in a bowl. Stir until the sugar dissolves completely."
        },
        {
            "step": 2,
            "instruction": "Reserve half for glazing during cooking. Use the remaining half to marinate chicken for 15 minutes at room temperature or up to overnight in the refrigerator."
        },
        {
            "step": 3,
            "instruction": "When cooking, brush the reserved marinade over the chicken during the last few minutes until thick, glossy, and caramelised."
        }
    ],
    "notes": [
        {
            "type": "technique",
            "title": "Dual Purpose",
            "content": "This marinade works as both a marinade and a glaze. Always reserve half before adding raw chicken — never reuse marinade that has touched raw meat."
        }
