  "method": [
    {
      "step": 1,
      "instruction": "In a large bowl, combine milk, yeast, and sugar. Let sit 5 minutes until foamy."
    },
    {
      "step": 2,
      "instruction": "Add flour, salt, melted butter, and egg. Mix until a smooth, slightly sticky dough forms. Knead 8–10 minutes until elastic."
    },
    {
      "step": 3,
      "instruction": "Cover and let dough rise until doubled, about 1–1.5 hours."
    },
    {
      "step": 4,
      "instruction": "Roll dough into a rectangle (~30×40 cm). Brush with melted butter and sprinkle evenly with the cinnamon-sugar mixture."
    },
    {
      "step": 5,
      "instruction": "Roll the dough tightly into a log, pinch the seam, and cut into 8–12 buns."
    },
    {
      "step": 6,
      "instruction": "Place buns in a greased tin with space between each. Cover and let rise 30–45 minutes."
    },
    {
      "step": 7,
      "instruction": "Preheat oven to 180°C. Bake buns 20–25 minutes until golden brown."
    },
    {
      "step": 8,
      "instruction": "Whisk powdered sugar, milk or cream, vanilla, and salt for the glaze. Drizzle over warm buns."
    },
    {
      "step": 9,
      "instruction": "Optional: brush a little extra melted butter over the glaze for an ultra-glossy finish."
    }
  ],
