    "method": [
        {
            "step": 1,
            "instruction": "Heat olive oil in a saucepan over medium heat."
        },
        {
            "step": 2,
            "instruction": "Sauté onion for 3–4 minutes until soft and translucent."
        },
        {
            "step": 3,
            "instruction": "Add garlic and cook for 30 seconds until fragrant."
        },
        {
            "step": 4,
            "instruction": "Add pureed tomatoes and Italian herbs. Stir well."
        },
        {
            "step": 5,
            "instruction": "Simmer on low heat for 15–20 minutes, stirring occasionally, until thickened."
        },
        {
            "step": 6,
            "instruction": "Season with salt and pepper. Cool slightly before using or storing."
        }
