  "method": [
    {
      "step": 1,
      "instruction": "Mix softened butter with garlic and parsley. Shape into a log and freeze until firm."
    },
    {
      "step": 2,
      "instruction": "Cut a deep pocket in each chicken breast. Insert frozen garlic butter log. Seal edges firmly."
    },
    {
      "step": 3,
      "instruction": "Dust each stuffed breast with flour, dip in egg wash, coat in breadcrumbs. Double crumb for a better seal."
    },
    {
      "step": 4,
      "instruction": "Deep fry at 180°C until golden and cooked through — approximately 8-10 minutes."
    },
    {
      "step": 5,
      "instruction": "For sauce: soften diced onion in a little butter until translucent."
    },
    {
      "step": 6,
      "instruction": "Add diced tomato and cook down briefly."
    },
    {
      "step": 7,
      "instruction": "Add thickened cream and a splash of tomato sauce. Let thicken to a light coating consistency."
    },
    {
      "step": 8,
      "instruction": "Plate chicken and spoon sauce over to serve."
    }
  ],
  "notes": [
    {
      "type": "chef",
      "title": "Chef's Note",
      "content": "The frozen butter log is essential — it melts inside as the chicken cooks, keeping it moist. Make sure edges are well sealed before crumbing or the butter escapes during frying."
    }
  ],
