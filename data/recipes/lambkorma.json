  "method": [
    {
      "step": 1,
      "instruction": "Heat oil in a heavy-bottomed pan over medium heat. Add onions and fry until softened."
    },
    {
      "step": 2,
      "instruction": "Add ginger paste and garlic paste. Fry for a few seconds."
    },
    {
      "step": 3,
      "instruction": "Add ground spices (cumin, nutmeg, garam masala, and red chili powder). Fry briefly."
    },
    {
      "step": 4,
      "instruction": "Add lamb pieces. Fry, stirring occasionally, 3–4 minutes until well coated and cooking begins."
    },
    {
      "step": 5,
      "instruction": "Mix yogurt with water, then add to curry. Stir well. Season with black pepper and salt."
    },
    {
      "step": 6,
      "instruction": "Cover with lid, bring to boil, then reduce heat and simmer until sauce thickens and lamb is cooked through."
    }
  ],
