  "method": [
    {
      "step": 1,
      "instruction": "Pan-fry chicken breast in butter until golden and cooked through. Remove and rest."
    },
    {
      "step": 2,
      "instruction": "In the same pan, soften shallots in butter."
    },
    {
      "step": 3,
      "instruction": "Deglaze with a splash of white wine. Add thickened cream and reduce to a coating consistency."
    },
    {
      "step": 4,
      "instruction": "Add oysters to the sauce in the last minute — just enough to warm through. Do not overcook."
    },
    {
      "step": 5,
      "instruction": "Return chicken to pan briefly to warm. Plate and spoon sauce and oysters over."
    }
  ],
  "notes": [
    {
      "type": "chef",
      "title": "Chef's Note",
      "content": "The oysters go in last — seconds only in the warm cream sauce. Overcooking makes them rubbery and defeats the dish entirely. No demi."
    }
