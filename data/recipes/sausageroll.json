  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 200°C (400°F). Line trays with baking paper."
    },
    {
      "step": 2,
      "instruction": "Mix sausage mince, grated onion, grated carrot, nutmeg, salt, and pepper until well combined."
    },
    {
      "step": 3,
      "instruction": "Cut each puff pastry sheet in half lengthwise. Place meat mixture along the long edge and roll tightly."
    },
    {
      "step": 4,
      "instruction": "Cut rolls into desired lengths (approx. 8–10 cm). Place on trays."
    },
    {
      "step": 5,
      "instruction": "Brush tops with beaten egg and sprinkle with sesame or poppy seeds if using."
    },
    {
      "step": 6,
      "instruction": "Bake 25–30 minutes until golden and puffed."
    }
  ],
  "notes": [
    {
