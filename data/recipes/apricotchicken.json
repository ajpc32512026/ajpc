  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C (350°F)."
    },
    {
      "step": 2,
      "instruction": "Drain apricot halves, reserving 300ml of syrup. Set apricots aside."
    },
    {
      "step": 3,
      "instruction": "In a bowl, combine reserved apricot syrup with soy sauce."
    },
    {
      "step": 4,
      "instruction": "Place chicken legs, diced onion, garlic, carrots, and red capsicum in a large casserole dish."
    },
    {
      "step": 5,
      "instruction": "Season with salt and pepper. Pour the syrup mixture over everything and toss to coat."
    },
    {
      "step": 6,
      "instruction": "Cover and bake for 40 minutes."
    },
    {
      "step": 7,
      "instruction": "Remove from oven. Add drained apricot halves, tucking them around the chicken."
    },
    {
      "step": 8,
      "instruction": "Cover and bake for final 10 minutes."
    },
    {
      "step": 9,
      "instruction": "Serve hot with rice or mashed potato."
    }
  ],
  "notes": [
    {
      "type": "tip",
      "title": "The Syrup",
      "content": "Your can gave 300ml syrup — perfect amount for this recipe. No extra liquid needed."
