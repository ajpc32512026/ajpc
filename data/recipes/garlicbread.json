    "method": [
        {
            "step": 1,
            "instruction": "In a large bowl, combine lukewarm milk, sugar, and yeast. Let sit for 5 minutes until slightly foamy."
        },
        {
            "step": 2,
            "instruction": "Add the egg, bread flour, and salt. Mix until a rough dough forms."
        },
        {
            "step": 3,
            "instruction": "Add 15 g butter and knead for 8–10 minutes until the dough is smooth, elastic, and no longer sticky."
        },
        {
            "step": 4,
            "instruction": "Place dough in a lightly oiled bowl, cover with a damp tea towel, and let rise in a warm place for 1–1½ hours or until doubled in sise."
        },
        {
            "step": 5,
            "instruction": "Punch down the dough and shape into a tight oval or log. Place in a greased loaf tin or on a lined baking tray."
        },
        {
            "step": 6,
            "instruction": "Cover and let rise for another 45–60 minutes until puffy."
        },
        {
            "step": 7,
            "instruction": "Preheat oven to 180°C."
        },
        {
            "step": 8,
            "instruction": "Meanwhile, make the garlic butter: mix softened butter, minced garlic, honey, salt, and chopped parsley until well combined."
        },
        {
            "step": 9,
            "instruction": "Bake for 18–22 minutes until golden brown and the loaf sounds hollow when tapped on the bottom."
        },
        {
            "step": 10,
            "instruction": "Remove from oven and immediately brush the hot loaf generously with the garlic butter mixture."
        },
        {
            "step": 11,
            "instruction": "Let cool for 10 minutes before slicing. Serve warm."
        }
    ],
    "notes": [
        {
            "type": "technique",
            "title": "Garlic Butter Timing",
            "content": "Brush the garlic butter on while the loaf is hot from the oven — it melts into the crust and soaks into the bread. Doing it cold will leave butter sitting on top."
        },
        {
            "type": "serving",
            "title": "Serving Tip",
            "content": "Serve warm with extra garlic butter on the side for dipping, or alongside pasta, soups, or salads."
        }
    ],
