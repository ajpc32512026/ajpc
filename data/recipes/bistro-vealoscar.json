  "method": [
    {
      "step": 1,
      "instruction": "Pan-fry veal until just cooked through. Place in an ovenproof dish."
    },
    {
      "step": 2,
      "instruction": "Lay blanched asparagus over the veal."
    },
    {
      "step": 3,
      "instruction": "Make Mornay sauce: melt butter, add flour, cook roux. Add warm milk gradually whisking until smooth. Add cheese off heat and season."
    },
    {
      "step": 4,
      "instruction": "Fold seafood into Mornay and heat through gently."
    },
    {
      "step": 5,
      "instruction": "Spoon seafood Mornay over veal and asparagus. Top with extra grated cheese."
    },
    {
      "step": 6,
      "instruction": "Grill under salamander until cheese is golden and bubbling."
    }
