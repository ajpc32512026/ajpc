  "method": [
    {
      "step": 1,
      "instruction": "Pound veal escalopes thin between plastic wrap."
    },
    {
      "step": 2,
      "instruction": "Lay ham and cheese on one half of each escalope. Fold veal over to encase the filling. Press edges firmly to seal."
    },
    {
      "step": 3,
      "instruction": "Dust with flour, dip in egg wash, coat in breadcrumbs."
    },
    {
      "step": 4,
      "instruction": "Deep fry at 180°C until golden and cooked through — approximately 4-5 minutes. Drain."
    },
    {
      "step": 5,
      "instruction": "For Dijon cream sauce: soften shallots in butter. Deglaze with white wine and reduce by half."
    },
    {
      "step": 6,
      "instruction": "Add thickened cream and Dijon mustard. Reduce to a coating consistency. Season."
    },
    {
      "step": 7,
      "instruction": "Plate and serve sauce alongside — not poured over — to preserve the crumb."
    }
  ],
  "notes": [
    {
      "type": "chef",
      "title": "Chef's Note",
      "content": "No original sauce on the menu — Dijon cream added as the crumb is too dry without it. Keep sauce on the side to protect the crumb texture. No demi."
    }
  ],
