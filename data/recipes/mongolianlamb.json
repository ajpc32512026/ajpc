  "method": [
    {
      "step": 1,
      "instruction": "Combine lamb with marinade ingredients, mix very well, cover, and refrigerate. Tender cuts: 2 hrs; Economical cuts: 6–24 hrs."
    },
    {
      "step": 2,
      "instruction": "Mix cornflour with soy sauces, then stir in remaining sauce ingredients."
    },
    {
      "step": 3,
      "instruction": "Heat oil in a wok over high heat. Stir-fry onions 30 sec until starting to colour, add garlic, toss quickly."
    },
    {
      "step": 4,
      "instruction": "Add lamb and cook ~3 mins until mostly brown with some golden edges."
    },
    {
      "step": 5,
      "instruction": "Add green onions, stir 30 sec, then pour in sauce. Simmer 1–2 mins until thickened."
    },
    {
      "step": 6,
      "instruction": "Serve immediately with steamed rice."
