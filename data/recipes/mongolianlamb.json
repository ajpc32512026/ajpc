  "method": [
    {
      "step": 1,
      "instruction": "Combine lamb with bi-carb soda, cornflour, light soy sauce, and Chinese rice wine. Mix very well, cover, and refrigerate. For tender cuts, marinate 2 hours. For economical cuts, marinate 6–24 hours."
    },
    {
      "step": 2,
      "instruction": "Mix cornflour with dark soy sauce and light soy sauce until smooth, then stir in sambal oelek, hoisin sauce, Chinese rice wine, five spice, and water. Set sauce aside."
    },
    {
      "step": 3,
      "instruction": "Heat vegetable oil and sesame oil in a wok over high heat until smoking."
    },
    {
      "step": 4,
      "instruction": "Stir-fry onion for 30 seconds until starting to colour. Add garlic and toss quickly for 10 seconds until fragrant."
    },
    {
      "step": 5,
      "instruction": "Add lamb and cook for approximately 3 minutes until mostly brown with some golden edges."
    },
    {
      "step": 6,
      "instruction": "Add green parts of spring onion, stir for 30 seconds, then pour in the sauce. Simmer for 1–2 minutes until thickened."
    },
    {
      "step": 7,
      "instruction": "Serve immediately with steamed rice."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Bi-Carb Soda Tenderising",
      "content": "The bi-carb soda in the marinade is a classic Chinese restaurant technique that tenderises the meat and gives it that signature silky texture."
    },
    {
      "type": "technique",
      "title": "Marinating Time",
      "content": "Tender cuts like lamb backstrap need only 2 hours. Economical cuts benefit from an overnight marinade — the longer the better."
    }
