  "method": [
    {
      "step": 1,
      "instruction": "Heat milk and butter until just melted. Stir in honey and vegetable oil."
    },
    {
      "step": 2,
      "instruction": "Dissolve yeast in lukewarm apple juice. Add egg, orange zest, flour, cinnamon, salt, and milk mixture. Knead until elastic and smooth. Cover and prove for 1 hour."
    },
    {
      "step": 3,
      "instruction": "Lightly pre-cook diced apples. Combine brown sugar, cinnamon, butter, and walnuts to form the filling."
    },
    {
      "step": 4,
      "instruction": "Roll dough into a rectangle, spread filling evenly, roll tightly, and slice into 12 scrolls. Place into a tray and prove for 30 minutes."
    },
    {
      "step": 5,
      "instruction": "Brush with egg yolk. Bake at 180°C for 22–25 minutes until golden and cooked through."
    },
    {
      "step": 6,
      "instruction": "Mix icing sugar, vanilla, and cream until smooth. Spread over scrolls while slightly warm."
    }
  ],
  "notes": [
    {
      "type": "storage",
      "title": "Freezing",
      "content": "Freeze un-iced scrolls for up to 2 months. Reheat gently and ice before serving."
    },
    {
      "type": "tip",
      "title": "Make Ahead",
      "content": "Dough can be refrigerated overnight after kneading. Bring to room temperature before rolling."
    },
    {
      "type": "variation",
      "title": "Substitutions",
      "content": "Walnuts can be swapped for pecans for a sweeter, softer crunch."
    }
  ],
