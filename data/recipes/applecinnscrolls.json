{
  "id": "applecinnscrolls",
  "title": "Apple & Cinnamon Scrolls",
  "emoji": "🍎",
  "category": "Baking",
  "description": "Golden, fragrant, and guaranteed to vanish fast. Best enjoyed warm and unapologetically drowned in icing.",
  "prepTime": "30 min",
  "cookTime": "25 min",
  "totalTime": "1 hr 55 min",
  "servings": "12 scrolls",
  "difficulty": "Medium",
  "tags": [
    "Apple",
    "Bread",
    "Breakfast",
    "Cinnamon",
    "Creamy",
    "Rich",
    "Sweet",
    "Under 1 Hour",
    "Vegetarian"
  ],
  "ingredients": [
    { "heading": "Dough" },
    { "quantity": "250", "unit": "ml", "item": "Milk",         "ingredientKey": "Milk" },
    { "quantity": "50",  "unit": "g",  "item": "Unsalted Butter",       "ingredientKey": "Butter" },
    { "quantity": "40",  "unit": "g",  "item": "Honey",        "notes": "light honey preferred", "ingredientKey": "Honey" },
    { "quantity": "30",  "unit": "ml", "item": "Vegetable Oil","ingredientKey": "Oil" },
    { "quantity": "100", "unit": "ml", "item": "Apple Juice",  "notes": "lukewarm", "ingredientKey": "Juice" },
    { "quantity": "7",   "unit": "g",  "item": "Dried Yeast",  "ingredientKey": "Yeast" },
    { "quantity": "1",   "unit": "",   "item": "Egg",          "ingredientKey": "Eggs" },
    { "quantity": "1",   "unit": "",   "item": "Egg Yolk",     "notes": "extra for dough", "ingredientKey": "Eggs" },
    { "quantity": "3",   "unit": "g",  "item": "Orange Zest",  "ingredientKey": "Orange Zest" },
    { "quantity": "400", "unit": "g",  "item": "Plain Flour",  "ingredientKey": "Flour" },
    { "quantity": "5",   "unit": "g",  "item": "Cinnamon",     "notes": "ground", "ingredientKey": "Cinnamon" },
    { "quantity": "2.5", "unit": "g",  "item": "Salt",         "ingredientKey": "Salt" },
    { "heading": "Filling" },
    { "quantity": "300", "unit": "g",  "item": "Apples",       "notes": "peeled and diced", "ingredientKey": "Apples" },
    { "quantity": "50",  "unit": "g",  "item": "Brown Sugar",  "notes": "packed", "ingredientKey": "Sugar" },
    { "quantity": "30",  "unit": "g",  "item": "Unsalted Butter",       "ingredientKey": "Butter" },
    { "quantity": "5",   "unit": "g",  "item": "Cinnamon",     "notes": "ground", "ingredientKey": "Cinnamon" },
    { "quantity": "50",  "unit": "g",  "item": "Walnuts",      "notes": "chopped", "ingredientKey": "Walnuts" },
    { "heading": "Icing" },
    { "quantity": "100", "unit": "g",  "item": "Pure Icing Sugar", "ingredientKey": "Sugar" },
    { "quantity": "50",  "unit": "ml", "item": "Heavy Cream",  "notes": "thickened cream", "ingredientKey": "Cream" },
    { "quantity": "5",   "unit": "ml", "item": "Vanilla Extract", "ingredientKey": "Vanilla" }
  ],
  "method": [
    { "step": 1, "instruction": "Heat milk and butter until just melted. Stir in honey and vegetable oil." },
    { "step": 2, "instruction": "Dissolve yeast in lukewarm apple juice. Add egg, orange zest, flour, cinnamon, salt, and milk mixture. Knead until elastic and smooth. Cover and prove for 1 hour." },
    { "step": 3, "instruction": "Lightly pre-cook diced apples. Combine brown sugar, cinnamon, butter, and walnuts to form the filling." },
    { "step": 4, "instruction": "Roll dough into a rectangle, spread filling evenly, roll tightly, and slice into 12 scrolls. Place into a tray and prove for 30 minutes." },
    { "step": 5, "instruction": "Brush with egg yolk. Bake at 180°C for 22–25 minutes until golden and cooked through." },
    { "step": 6, "instruction": "Mix icing sugar, vanilla, and cream until smooth. Spread over scrolls while slightly warm." }
  ],
  "notes": [
    {
      "type": "storage",
      "title": "Freezing",
      "content": "Freeze un-iced scrolls for up to 2 months. Reheat gently and ice before serving."
    },
    {
      "type": "preparation",
      "title": "Make Ahead",
      "content": "Dough can be refrigerated overnight after kneading. Bring to room temperature before rolling."
    },
    {
      "type": "variation",
      "title": "Substitutions",
      "content": "Walnuts can be swapped for pecans for a sweeter, softer crunch."
    }
  ],
