  "method": [
    {
      "step": 1,
      "instruction": "Combine beef with marinade ingredients, mixing well. Set aside for 1 hour."
    },
    {
      "step": 2,
      "instruction": "Mix cornflour with soy sauces, then stir in remaining sauce ingredients. Set aside."
    },
    {
      "step": 3,
      "instruction": "Heat oil in a wok on high. Stir-fry onion and the white parts of spring onions for 1 minute. Add garlic and cook 10 seconds."
    },
    {
      "step": 4,
      "instruction": "Add marinated beef and stir-fry until no longer red, about 2 minutes."
    },
    {
      "step": 5,
      "instruction": "Pour in the sauce and cook until reduced and caramelised, about 3 minutes."
    },
    {
      "step": 6,
      "instruction": "Toss through the green parts of the spring onions until just wilted. Serve immediately — ideally in a hot cast-iron pan for sizzling effect."
    }
  ],
