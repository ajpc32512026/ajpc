  "method": [
    {
      "step": 1,
      "instruction": "In a large bowl, mix 250 ml water, sugar, and yeast."
    },
    {
      "step": 2,
      "instruction": "Add olive oil and 400 g of flour. Mix until smooth."
    },
    {
      "step": 3,
      "instruction": "Add remaining 252 ml water and rest of the flour (600–650 g)."
    },
    {
      "step": 4,
      "instruction": "Add salt. Mix to a very wet, sticky dough."
    },
    {
      "step": 5,
      "instruction": "Cover and rest 20 minutes."
    },
    {
      "step": 6,
      "instruction": "With wet hands, stretch and fold several times."
    },
    {
      "step": 7,
      "instruction": "Rest 20 minutes."
    },
    {
      "step": 8,
      "instruction": "Repeat folds. Rest 20 minutes."
    },
    {
      "step": 9,
      "instruction": "Oil hands, fold once more."
    },
    {
      "step": 10,
      "instruction": "Cover and rise 1 hour until bubbly and doubled."
    },
    {
      "step": 11,
      "instruction": "Heavily flour bench."
    },
    {
      "step": 12,
      "instruction": "Turn out dough and dust lightly."
    },
    {
      "step": 13,
      "instruction": "Gently stretch into a rectangle — no kneading."
    },
    {
      "step": 14,
      "instruction": "Fold once, cut into 6 pieces."
    },
    {
      "step": 15,
      "instruction": "Transfer to floured tray."
    },
    {
      "step": 16,
      "instruction": "Rest 20 minutes."
    },
    {
      "step": 17,
      "instruction": "Bake at 200°C (400°F) for 15–25 minutes until golden."
    },
    {
      "step": 18,
      "instruction": "Cool fully before slicing to preserve the big holes."
    }
  ],
  "notes": [
    {
      "title": "Notes & Tips",
      "content": "Use wet hands to handle the dough — it’s extremely sticky. For best crust, bake on a preheated tray or stone."
    },
