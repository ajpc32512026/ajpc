  "method": [
    {
      "step": 1,
      "instruction": "Dry roast the dried chillies, coriander, cumin, fenugreek, cardamom, cloves, cinnamon, and peppercorns over low heat until aromatic."
    },
    {
      "step": 2,
      "instruction": "Remove from heat and allow spices to cool slightly."
    },
    {
      "step": 3,
      "instruction": "Transfer spices to a grinder."
    },
    {
      "step": 4,
      "instruction": "Add ginger, garlic, and lemon juice."
    },
    {
      "step": 5,
      "instruction": "Process into a smooth paste, adding a little water if needed."
    }
