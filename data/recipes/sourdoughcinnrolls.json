    "method": [
        {
            "step": 1,
            "instruction": "The night before: mix sourdough starter, sugar, warm water, and bread flour into a firm dough. Knead briefly, cover loosely, and leave at room temperature overnight until tripled and bubbly."
        },
        {
            "step": 2,
            "instruction": "Make the tangzhong: heat bread flour and milk in a small saucepan over medium heat, stirring constantly, until thickened to 65°C. Transfer to a bowl, cover, and cool completely."
        },
        {
            "step": 3,
            "instruction": "In the bowl of a stand mixer, combine the stiff starter, cooled tangzhong, milk, water, egg, vanilla extract, sugar, bread flour, cinnamon, and salt. Mix until smooth."
        },
        {
            "step": 4,
            "instruction": "Add softened butter gradually while mixing on medium speed. Continue mixing until the dough is very soft, smooth, and elastic — about 10–15 minutes."
        },
        {
            "step": 5,
            "instruction": "Cover and let rise at 24–29°C until increased by about 30%, then refrigerate until evening."
        },
        {
            "step": 6,
            "instruction": "Roll dough into a rectangle approximately 6 mm thick. Spread softened butter over the surface, then sprinkle evenly with brown sugar and cinnamon."
        },
        {
            "step": 7,
            "instruction": "Roll tightly from the long edge into a log. Cut into 12 even slices and place into a greased baking pan."
        },
        {
            "step": 8,
            "instruction": "Cover and proof overnight at room temperature, approximately 21–23°C."
        },
        {
            "step": 9,
            "instruction": "Preheat oven to 175°C. Pour half and half over the rolls. Bake for 30–35 minutes until the internal temperature reaches approximately 90°C."
        },
        {
            "step": 10,
            "instruction": "Cool for 10 minutes. For the icing: beat cream cheese and butter until smooth. Add icing sugar, vanilla, cinnamon, and salt. Beat until creamy. Spread over warm rolls."
        }
    ],
    "notes": [
        {
            "type": "technique",
            "title": "Half and Half",
            "content": "Half and half is equal parts whole milk and cream. If unavailable, mix 40 g whole milk with 40 g thickened cream."
        },
        {
            "type": "technique",
            "title": "Timeline",
            "content": "This is a flexible overnight recipe. Use refrigeration to slow things down if needed — the dough can be held at most stages. The starter should be fully risen and sweet-smelling before use."
        },
