  "method": [
    {
      "step": 1,
      "instruction": "In the evening, mix all stiff sweet starter ingredients into a firm dough. Knead briefly, cover loosely, and ferment overnight until tripled and bubbly."
    },
    {
      "step": 2,
      "instruction": "Prepare the tangzhong by heating flour and milk until thickened to 65°C. Cool completely before use."
    },
    {
      "step": 3,
      "instruction": "Mix all dough ingredients except butter until smooth. Add butter gradually and mix until very soft and elastic."
    },
    {
      "step": 4,
      "instruction": "Cover and rise at 24–29°C until increased by about 30%, then refrigerate until bedtime."
    },
    {
      "step": 5,
      "instruction": "Roll dough to ¼-inch thickness. Spread filling evenly, cut into 12 strips, roll tightly, and place into a greased baking pan."
    },
    {
      "step": 6,
      "instruction": "Cover and proof overnight at room temperature (21–23°C)."
    },
    {
      "step": 7,
      "instruction": "Preheat oven to 175°C. Pour half & half over the rolls and bake for 30–35 minutes until internal temperature reaches about 90°C."
    },
    {
      "step": 8,
      "instruction": "Cool for 10 minutes, then finish with icing or glaze of choice."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Notes",
      "content": "Half & half is equal parts whole milk and cream. Starter should be fully risen and sweet-smelling. Timeline is flexible—use refrigeration to adjust as needed."
    },
