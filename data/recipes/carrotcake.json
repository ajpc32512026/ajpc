  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 150°C. Grease and line a 20 cm round cake tin."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, beat eggs and sugar until thick and pale."
    },
    {
      "step": 3,
      "instruction": "Add flour, vanilla, oil, baking powder, salt, and cinnamon. Mix until smooth and well combined."
    },
    {
      "step": 4,
      "instruction": "Fold through grated carrots, sultanas, and walnuts evenly."
    },
    {
      "step": 5,
      "instruction": "Pour mixture into prepared tin and smooth the surface."
    },
    {
      "step": 6,
      "instruction": "Place a deep tray of water on the lower oven rack to create moisture."
    },
    {
      "step": 7,
      "instruction": "Bake for 21/2–3 hours, or until a skewer inserted into the centre comes out clean."
    },
    {
      "step": 8,
      "instruction": "Cool in the tin for 10 minutes, then turn out onto a wire rack and cool completely."
    },
    {
      "step": 9,
      "instruction": "Beat softened cream cheese until smooth."
    },
    {
      "step": 10,
      "instruction": "Gradually add icing sugar until sweetened to taste."
    },
    {
      "step": 11,
      "instruction": "Add lemon juice for balance and vanilla essence to finish."
    },
    {
      "step": 12,
      "instruction": "Spread frosting generously over the cooled cake."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Slow Bake",
      "content": "The low temperature and long bake produce a dense, moist crumb that improves over the next day."
    },
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Keeps well for several days refrigerated. Bring to room temperature before serving."
