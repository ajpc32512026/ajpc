  "method": [
    {
      "step": 1,
      "instruction": "Combine flour, sugar, ground almonds, and butter. Rub together until crumbly, then bring together into a dough. Chill for 30 minutes."
    },
    {
      "step": 2,
      "instruction": "Roll pastry out and line a flan tin. Blind bake until lightly golden, then cool completely."
    },
    {
      "step": 3,
      "instruction": "Beat egg yolks with sugar and vanilla. Gradually add warm milk, then cook gently until thickened. Cool slightly and fold through whipped cream."
    },
    {
      "step": 4,
      "instruction": "Fill cooled pastry shell with custard. Arrange apricot halves over the top."
    },
    {
      "step": 5,
      "instruction": "Warm apricot jam with brandy and brush over fruit. Finish with flaked almonds and chill until set."
    }
  ],
  "notes": [
    {
      "type": "tip",
      "title": "Make Ahead",
      "content": "The pastry shell can be baked a day in advance. Assemble the flan on the day of serving to keep the base crisp."
    },
    {
      "type": "technique",
      "title": "Brandy",
      "content": "To retain alcohol content, remove the pan from heat before adding. If the recipe calls for flambéing, that's intentional — but for sauces and braises where you want the flavour without burning off the alcohol, keep the heat low and never boil after adding."
    }
  ],
