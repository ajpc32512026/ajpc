  "method": [
    {
      "step": 1,
      "instruction": "Combine roughly chopped dried apricots and almonds to make the stuffing."
    },
    {
      "step": 2,
      "instruction": "Cut a deep pocket in each breast. Fill with the apricot and almond stuffing. Secure with a toothpick if needed."
    },
    {
      "step": 3,
      "instruction": "Pan-fry in butter until golden and cooked through."
    },
    {
      "step": 4,
      "instruction": "Remove chicken and set aside. Add cream and apricot juice to the pan."
    },
    {
      "step": 5,
      "instruction": "Stir and reduce to a light coating consistency. Add diced apricots and heat through."
    },
    {
      "step": 6,
      "instruction": "Season. Remove toothpick from chicken. Plate and spoon sauce over."
    }
  ],
  "notes": [
    {
      "type": "chef",
      "title": "Chef's Note",
      "content": "Sauce is cream, apricot juice and diced apricots — let it thicken naturally. No jam, no demi. The stuffing is loose — no binding agent needed, just pack it in."
    }
