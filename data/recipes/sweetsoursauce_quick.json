  "method": [
    {
      "step": 1,
      "instruction": "Combine sugar, vinegar, tomato sauce, soy sauce, and pineapple juice in a small saucepan."
    },
    {
      "step": 2,
      "instruction": "Bring to a gentle simmer over medium heat, stirring until the sugar dissolves."
    },
    {
      "step": 3,
      "instruction": "In a small bowl, mix cornflour with water to form a smooth slurry. Stir into the saucepan."
    },
    {
      "step": 4,
      "instruction": "Continue stirring until the sauce thickens, about 1–2 minutes. Remove from heat and cool slightly before serving."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Perfect with fried chicken, pork, or prawns. Also great as a dipping sauce for spring rolls or drizzled over stir-fried vegetables."
