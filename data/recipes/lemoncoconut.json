  "method": [
    {
      "step": "1",
      "instruction": "Preheat oven to moderate (around 180°C). Grease and line a 20 cm lamington tin."
    },
    {
      "step": "2",
      "instruction": "In a saucepan, add milk and butter, stir over medium heat until butter is melted. Add the sifted flour and sugar. Stir gently until the sugar dissolves."
    },
    {
      "step": "3",
      "instruction": "Add the eggs, one at a time mixing between additions, lemon juice, and coconut. Stir only until just combined."
    },
    {
      "step": "4",
      "instruction": "Add the milk and fold through gently."
    },
    {
      "step": "5",
      "instruction": "For extra flavour and texture, add lemon zest before pouring into the tin."
    },
    {
      "step": "6",
      "instruction": "Pour the mixture into the prepared tin and bake for 35–40 minutes or until a skewer comes out clean."
    },
    {
      "step": "7",
      "instruction": "Allow the cake to cool completely before icing."
    },
    {
      "step": "8",
      "instruction": "Sift icing sugar into a bowl."
    },
    {
      "step": "9",
      "instruction": "Add lemon juice slowly, mixing until a thick paste forms."
    },
    {
      "step": "10",
      "instruction": "Spread over the cooled cake."
    },
    {
      "step": "11",
      "instruction": "Sprinkle with lemon zest and coconut for decoration."
    }
  ],
