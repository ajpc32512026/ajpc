      "notes": "softened"
    },
    {
      "quantity": "10",
      "unit": "g",
      "item": "White Sugar"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 175°C and line a 12-hole muffin tray with paper cases."
    },
    {
      "step": 2,
      "instruction": "Whisk milk and eggs together in a bowl. Gradually whisk in vegetable oil until emulsified."
    },
    {
      "step": 3,
      "instruction": "Add sugar and mix until dissolved."
    },
    {
      "step": 4,
      "instruction": "Sift in plain flour, milk powder, and baking powder. Mix gently until just combined — do not overmix."
    },
    {
      "step": 5,
      "instruction": "Prepare the crumble topping by rubbing flour, butter, and sugar together until coarse crumbs form."
    },
    {
      "step": 6,
      "instruction": "Spoon batter into muffin cases, filling about three-quarters full."
    },
    {
      "step": 7,
      "instruction": "Scatter blueberries over the batter and finish with crumble topping."
    },
    {
      "step": 8,
      "instruction": "Bake for 25 minutes, or until golden and a skewer inserted into the centre comes out clean."
    }
  ],
  "notes": [
    {
      "type": "technique",
      "title": "Light Muffins",
      "content": "Mix the batter gently and stop as soon as it comes together — overmixing develops gluten and makes muffins tough."
    },
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Best eaten warm on the day, but excellent toasted lightly the next morning."
    }
  ],
