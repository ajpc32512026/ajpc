      "ingredientKey": "Coriander"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Place cumin and coriander seeds in a frying pan over low heat. Roast, stirring constantly, for 2 minutes or until slightly browned. Remove from heat and let cool."
    },
    {
      "step": 2,
      "instruction": "Transfer to a food processor. Add turmeric, garam masala, red chili powder, garlic, ginger, tomato paste, desiccated coconut, cashews, oil, and coriander leaves."
    },
    {
      "step": 3,
      "instruction": "Grind to a smooth paste. Store in the refrigerator for 2–3 days."
    }
  ],
