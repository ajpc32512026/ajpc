{
  "id": "mushroomcups",
  "title": "Mushrooms with Herb Nut Butter",
  "emoji": "🍄",
  "category": "Dinner",
  "description": "Baked mushroom caps filled with a rich herb and almond butter, finished until golden and fragrant.",
  "prepTime": "10 min",
  "cookTime": "15 min",
  "totalTime": "25 min",
  "servings": "4–6",
  "difficulty": "Medium",
  "tags": [
    "Baked",
    "Dinner",
    "Gluten-Free",
    "Rich",
    "Savoury",
    "Under 30 Minutes",
    "Vegetarian"
  ],
  "ingredients": [
    {
      "quantity": "12",
      "unit": "large",
      "item": "mushrooms",
      "ingredientKey": "Mushrooms"
    },
    {
      "quantity": "1",
      "unit": "tbsp",
      "item": "olive oil",
      "ingredientKey": "Oil"
    },
    {
      "quantity": "1",
      "unit": "small",
      "item": "onion, finely chopped",
      "ingredientKey": "Onion"
    },
    {
      "quantity": "40",
      "unit": "g",
      "item": "blanched almonds",
      "ingredientKey": "Almonds"
    },
    {
      "quantity": "1",
      "unit": "clove",
      "item": "garlic",
      "ingredientKey": "Garlic"
    },
    {
      "quantity": "1",
      "unit": "tbsp",
      "item": "lemon juice",
      "ingredientKey": "Juice"
    },
    {
      "quantity": "3",
      "unit": "tbsp",
      "item": "fresh parsley, chopped",
      "ingredientKey": "Parsley"
    },
    {
      "quantity": "3",
      "unit": "tsp",
      "item": "fresh thyme",
      "ingredientKey": "Thyme"
    },
    {
      "quantity": "3",
      "unit": "tsp",
      "item": "fresh rosemary",
      "ingredientKey": "Rosemary"
    },
    {
      "quantity": "1",
      "unit": "tbsp",
      "item": "chives, chopped",
      "ingredientKey": "Chives"
    },
    {
      "quantity": "1/2",
      "unit": "tsp",
      "item": "salt",
      "ingredientKey": "Salt"
    },
    {
      "quantity": "1/4",
      "unit": "tsp",
      "item": "black pepper",
      "ingredientKey": "Pepper"
    },
    {
      "quantity": "75",
      "unit": "g",
      "item": "butter, softened",
      "ingredientKey": "Butter"
    }
  ],
  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Brush a shallow baking dish with oil or melted butter."
    },
    {
      "step": 2,
      "instruction": "Remove mushroom stalks and chop them finely."
    },
    {
      "step": 3,
      "instruction": "Heat olive oil in a small pan. Add onion and cook for 2–3 minutes until soft and golden."
    },
    {
      "step": 4,
      "instruction": "Add chopped mushroom stalks and cook for a further 2 minutes until softened. Remove from heat."
    },
    {
      "step": 5,
      "instruction": "Place almonds, garlic, lemon juice, parsley, thyme, rosemary, chives, salt, pepper, and butter into a food processor."
    },
    {
      "step": 6,
      "instruction": "Process until smooth and well combined."
    },
    {
      "step": 7,
      "instruction": "Arrange mushroom caps in the prepared baking dish."
    },
    {
      "step": 8,
      "instruction": "Spoon the onion and mushroom stalk mixture evenly into each cap."
    },
    {
      "step": 9,
      "instruction": "Top each mushroom with the herb nut butter."
    },
    {
      "step": 10,
      "instruction": "Bake for 10–15 minutes or until mushrooms are tender and butter has melted."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Notes",
      "content": "Mushrooms are best baked just before serving. Caps may be assembled up to 2 hours ahead and refrigerated on a flat tray."
    },
