  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C. Brush a shallow baking dish with oil or melted butter."
    },
    {
      "step": 2,
      "instruction": "Remove mushroom stalks and chop them finely. Set caps aside."
    },
    {
      "step": 3,
      "instruction": "Heat olive oil in a small pan over medium heat. Add onion and cook for 2–3 minutes until soft and golden."
    },
    {
      "step": 4,
      "instruction": "Add chopped mushroom stalks and cook for a further 2 minutes until softened. Remove from heat."
    },
    {
      "step": 5,
      "instruction": "Place almonds, garlic, lemon juice, parsley, thyme, rosemary, chives, salt, pepper, and butter into a food processor. Process until smooth and well combined."
    },
    {
      "step": 6,
      "instruction": "Arrange mushroom caps in the prepared baking dish."
    },
    {
      "step": 7,
      "instruction": "Spoon the onion and mushroom stalk mixture evenly into each cap."
    },
    {
      "step": 8,
      "instruction": "Top each mushroom with the herb nut butter."
    },
    {
      "step": 9,
      "instruction": "Bake for 10–15 minutes or until mushrooms are tender and butter has melted."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Make Ahead",
      "content": "Mushroom caps may be assembled up to 2 hours ahead and refrigerated on a flat tray. Bake just before serving."
    },
