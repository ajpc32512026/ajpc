  "method": [
    {
      "step": 1,
      "instruction": "Peel, core, and slice the apples evenly."
    },
    {
      "step": 2,
      "instruction": "Place apples, sugar, cloves, and water into a saucepan. Simmer gently until apples are just tender. Set aside to cool."
    },
    {
      "step": 3,
      "instruction": "Sift plain flour, self-raising flour, and custard powder into a bowl. Rub in butter until the mixture resembles fine breadcrumbs."
    },
    {
      "step": 4,
      "instruction": "Add cold water gradually and bring together into a soft dough. Roll out and line a greased pie tin."
    },
    {
      "step": 5,
      "instruction": "Fill with cooled apple mixture, cover with remaining pastry, seal edges, and bake at 180°C until golden and crisp."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Allow the pie to rest briefly before slicing. Serve warm with cream, custard, or vanilla ice cream."
