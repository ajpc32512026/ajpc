  "method": [
    {
      "step": 1,
      "instruction": "Pan-fry veal until just cooked through. Rest — veal toughens quickly if overdone."
    },
    {
      "step": 2,
      "instruction": "In the same pan, fry bacon until beginning to crisp."
    },
    {
      "step": 3,
      "instruction": "Add onion and capsicum and soften."
    },
    {
      "step": 4,
      "instruction": "Add garlic and chilli (for hot version). Cook briefly."
    },
    {
      "step": 5,
      "instruction": "Add diced tomato and cook down slightly."
    },
    {
      "step": 6,
      "instruction": "Add demi glace base and thickened cream. Stir and reduce to a rich sauce."
    },
    {
      "step": 7,
      "instruction": "Add green peppercorns."
    },
    {
      "step": 8,
      "instruction": "Return veal to pan briefly to warm through. Plate and spoon sauce generously over."
    }
