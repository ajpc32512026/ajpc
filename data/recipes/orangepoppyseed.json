  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C (moderate). Grease a deep 22 cm round cake tin and line the base with greaseproof paper."
    },
    {
      "step": 2,
      "instruction": "Combine the poppy seeds and milk in a bowl. Let stand 20 minutes to soften and bloom."
    },
    {
      "step": 3,
      "instruction": "Cream butter, orange rind, and caster sugar with an electric mixer until light and fluffy."
    },
    {
      "step": 4,
      "instruction": "Add eggs one at a time, beating well after each."
    },
    {
      "step": 5,
      "instruction": "Transfer mixture to a large bowl. Stir in sifted flours, almond meal, poppy seed mixture, and orange juice. Mix until just combined."
    },
    {
      "step": 6,
      "instruction": "Spread into prepared tin and bake 45 minutes or until a skewer comes out clean."
    },
    {
      "step": 7,
      "instruction": "Cool on wire rack. Once cold, slice horizontally into three layers."
    },
    {
      "step": 8,
      "instruction": "Sandwich layers with half the orange cream, then cover top and sides with remaining cream."
    },
    {
      "step": 9,
      "instruction": "Allow Philadelphia Cream Cheese to soften at room temperature."
    },
    {
      "step": 10,
      "instruction": "Beat Philadelphia Cream Cheese, sour cream, and orange rind until smooth."
    },
    {
      "step": 11,
      "instruction": "Add sifted icing sugar and orange juice, then beat until thick, glossy, and silky."
    }
  ],
