  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 180°C (350°F). Line baking trays with parchment paper."
    },
    {
      "step": 2,
      "instruction": "Cream butter and both sugars until smooth and fluffy. Add eggs one at a time, then stir in vanilla extract."
    },
    {
      "step": 3,
      "instruction": "Sift together flour, cocoa powder, baking soda, and salt. Fold into the wet mixture until just combined."
    },
    {
      "step": 4,
      "instruction": "Fold in all the chocolate chips — don’t be shy!"
    },
    {
      "step": 5,
      "instruction": "Drop spoonfuls of dough onto the trays, leaving enough space for spreading."
    },
    {
      "step": 6,
      "instruction": "Bake for 10–12 minutes. Let cookies rest on the tray for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
