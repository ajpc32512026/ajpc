  "method": [
    {
      "step": 1,
      "instruction": "Melt butter gently in a wide pan over low heat, taking care not to brown it."
    },
    {
      "step": 2,
      "instruction": "Add garlic and cook briefly until fragrant, about 30 seconds."
    },
    {
      "step": 3,
      "instruction": "Pour in cream and bring to a gentle simmer. Cook for 3–4 minutes until slightly thickened."
    },
    {
      "step": 4,
      "instruction": "Reduce heat to low and gradually stir in Parmesan until fully melted and smooth."
    },
    {
      "step": 5,
      "instruction": "Season with salt and black pepper, adjusting to taste."
    },
    {
      "step": 6,
      "instruction": "Serve immediately over hot pasta, loosening with a splash of pasta water if needed."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Best paired with fettuccine. Add grilled chicken, prawns, or mushrooms for a complete dish."
    },
    {
      "type": "technique",
      "title": "Sauce Consistency",
      "content": "If the sauce thickens too much, loosen gently with reserved pasta water rather than extra cream."
    }
  ],
