  "method": [
    {
      "step": "1",
      "instruction": "Heat olive oil in a large pan. Sauté onion and garlic for 5–6 minutes until softened."
    },
    {
      "step": "2",
      "instruction": "Add mince and brown well, breaking up lumps."
    },
    {
      "step": "3",
      "instruction": "Stir in tomato paste, then add tomatoes, sugar, Italian herbs, salt, pepper, and wine (if using)."
    },
    {
      "step": "4",
      "instruction": "Simmer on low for 45–60 minutes until thick and rich."
    },
    {
      "step": "5",
      "instruction": "Melt butter in a saucepan. Whisk in flour and cook 1–2 minutes."
    },
    {
      "step": "6",
      "instruction": "Slowly whisk in milk until smooth and thickened (5–7 minutes)."
    },
    {
      "step": "7",
      "instruction": "Season with salt, pepper, nutmeg, and Parmesan (optional)."
    },
    {
      "step": "8",
      "instruction": "Preheat oven to 180°C (350°F)."
    },
    {
      "step": "9",
      "instruction": "Spread a thin layer of ragù in a 23×33 cm dish."
    },
    {
      "step": "10",
      "instruction": "Layer: pasta → ragù → béchamel → mozzarella. Repeat 2–3 times."
    },
    {
      "step": "11",
      "instruction": "Finish with béchamel and Parmesan."
    },
    {
      "step": "12",
      "instruction": "Cover with foil and bake 30 minutes."
    },
    {
      "step": "13",
      "instruction": "Uncover and bake 15–20 minutes until golden and bubbling."
    },
    {
      "step": "14",
      "instruction": "Rest 10 minutes before slicing."
    }
  ],
