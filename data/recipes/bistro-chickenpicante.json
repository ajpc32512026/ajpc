  "method": [
    {
      "step": 1,
      "instruction": "Pan-fry chicken breast in butter until golden and cooked through. Rest."
    },
    {
      "step": 2,
      "instruction": "In the same pan, soften shallots in butter. Deglaze with white wine."
    },
    {
      "step": 3,
      "instruction": "Add thickened cream, Dijon mustard and green peppercorns. Reduce to a coating sauce."
    },
    {
      "step": 4,
      "instruction": "Adjust seasoning carefully — Dijon is salty, go easy on added salt."
    },
    {
      "step": 5,
      "instruction": "Plate chicken and spoon sauce generously over."
    }
  ],
  "notes": [
    {
      "type": "chef",
      "title": "Chef's Note",
      "content": "Green peppercorns from the brine jar — not dried. Dijon gives it the bite. Don't overdo the mustard or it turns bitter. No demi."
    }
