      "quantity": "2",
      "unit": "sheets",
      "item": "Pastry",
      "ingredientKey": "Pastry"
    },
    {
      "quantity": "1",
      "unit": "",
      "item": "Eggs",
      "ingredientKey": "Eggs"
    }
  ],
  "method": [
    {
      "step": "1",
      "instruction": "Preheat oven to 200°C (400°F). Grease pie tins or muffin tins."
    },
    {
      "step": "2",
      "instruction": "Sauté onion until soft. Add mince and cook until browned."
    },
    {
      "step": "3",
      "instruction": "Stir in flour and cook for 1 minute."
    },
    {
      "step": "4",
      "instruction": "Add stock, tomato paste, and Worcestershire sauce. Simmer 15–20 minutes until thick."
    },
    {
      "step": "5",
      "instruction": "Season with salt and pepper. Cool slightly."
    },
    {
      "step": "6",
      "instruction": "Line tins with shortcrust pastry and fill generously with meat mixture."
    },
    {
      "step": "7",
      "instruction": "Top with puff pastry, seal edges, and poke a vent hole in each pie."
    },
    {
      "step": "8",
      "instruction": "Brush with beaten egg."
    },
    {
      "step": "9",
      "instruction": "Bake 25–30 minutes until golden and proudly puffed."
    }
  ],
  "notes": [
    {
      "title": "Tip",
      "content": "Add a little Vegemite to the filling for deeper, proper Aussie savouriness."
    },
