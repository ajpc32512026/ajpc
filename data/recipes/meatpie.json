{
  "id": "meatpie",
  "title": "Classic Aussie Meat Pies",
  "emoji": "🥧",
  "category": "Dinner",
  "description": "True blue, unapologetically hearty, and as Australian as a sunburn at Christmas.",
  "ingredients": [
    {
      "quantity": "500",
      "unit": "g",
      "item": "Minced Meat",
      "ingredientKey": "Minced Meat"
    },
    {
      "quantity": "1",
      "unit": "",
