  "method": [
    {
      "step": 1,
      "instruction": "Place onions in a food processor. Add a little water and grind to a smooth paste. Set aside."
    },
    {
      "step": 2,
      "instruction": "Place ginger and garlic in a food processor. Add a little water and grind to a coarse paste. Set aside."
    },
    {
      "step": 3,
      "instruction": "Heat a small frying pan over low heat. Add fennel and cumin seeds. Roast 2–3 minutes until aromatic. Let cool, then grind to coarse powder."
    },
    {
      "step": 4,
      "instruction": "Combine fennel-cumin mix, ground coriander, turmeric, garam masala, paprika, and red chili powder in a small bowl. Set aside."
    },
    {
      "step": 5,
      "instruction": "Heat oil in a large casserole over medium-high heat. Stir fry cardamom, cloves, and bay leaves for 1–2 minutes."
    },
    {
      "step": 6,
      "instruction": "Add onion paste. Cook 1–2 minutes until raw smell disappears. Add ginger garlic paste and cook 2 minutes until fragrant."
    },
    {
      "step": 7,
      "instruction": "Stir in spice mix. Cook 1 minute until aromatic. Add tomato paste and diced tomatoes. Cook 1–2 minutes, stirring often."
    },
    {
      "step": 8,
      "instruction": "Add lamb. Season with salt. Cook 10 minutes, stirring occasionally. Stir in yogurt. Cover lamb with 250 ml hot water and bring to boil."
    },
    {
      "step": 9,
      "instruction": "Reduce heat to medium-low. Simmer covered, stirring occasionally, 30–40 minutes until lamb is cooked through."
    },
    {
      "step": 10,
      "instruction": "Sprinkle with chopped coriander and mint leaves. Serve with naan, roti, or rice."
    }
  ],
