  "method": [
    {
      "step": 1,
      "instruction": "In a large bowl, whisk together olive oil, lemon juice, garlic, salt, paprika, cumin, cardamom, crushed red pepper, and cinnamon."
    },
    {
      "step": 2,
      "instruction": "Add chicken to the marinade and stir to coat evenly. Cover and refrigerate for at least 1 hour or up to 24 hours."
    },
    {
      "step": 3,
      "instruction": "Preheat oven to 400°F (200°C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "step": 4,
      "instruction": "Arrange chicken on the prepared sheet and roast for 15 minutes, turning halfway, until cooked through."
    },
    {
      "step": 5,
      "instruction": "Remove from oven and thinly slice the chicken. For seared edges, sauté slices in a skillet with juices for 5 minutes, avoiding overcrowding."
    },
    {
      "step": 6,
      "instruction": "Serve over rice or in pita with pickles, tomatoes, lettuce, and garlic or tahini sauce."
    }
  ],
