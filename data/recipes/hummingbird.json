  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 170°C. Lightly grease a 20 cm round cake tin and dust with flour, shaking out any excess."
    },
    {
      "step": 2,
      "instruction": "Sift flour, caster sugar, cinnamon, and bi-carb soda into a large mixing bowl. Whisk briefly to combine."
    },
    {
      "step": 3,
      "instruction": "Add lightly beaten eggs and oil, then fold in chopped nuts, mashed bananas, and crushed pineapple including syrup."
    },
    {
      "step": 4,
      "instruction": "Fold gently from bottom upward until no dry patches remain. Avoid overmixing."
    },
    {
      "step": 5,
      "instruction": "Pour batter into prepared tin, level the top, and bake for about 45–50 minutes or until a skewer comes out clean."
    },
    {
      "step": 6,
      "instruction": "Cool in the tin for 10 minutes, then transfer to a wire rack. Cool completely before frosting."
    },
    {
      "step": 7,
      "instruction": "Beat Philadelphia Cream Cheese, sour cream, butter, and vanilla essence together until smooth, pale, and fluffy."
    },
    {
      "step": 8,
      "instruction": "Gradually beat in sifted icing sugar until thick and silky."
    },
    {
      "step": 9,
      "instruction": "Spread thickly over the completely cooled cake."
    }
  ],
