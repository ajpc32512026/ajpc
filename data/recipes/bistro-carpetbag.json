  "method": [
    {
      "step": 1,
      "instruction": "Cut a deep horizontal pocket in each scotch filet."
    },
    {
      "step": 2,
      "instruction": "Stuff with oysters and slices of Camembert. Seal pocket with a toothpick."
    },
    {
      "step": 3,
      "instruction": "Pan-fry to desired doneness — the Camembert will melt inside. Rest."
    },
    {
      "step": 4,
      "instruction": "In the same pan, soften shallots in butter. Deglaze with red wine."
    },
    {
      "step": 5,
      "instruction": "Add demi glace base and reduce to a glossy sauce."
    },
    {
      "step": 6,
      "instruction": "Remove toothpick. Plate and spoon sauce over."
    }
  ],
