  "method": [
    {
      "step": 1,
      "instruction": "Heat 30 ml of oil in a wok over medium-high heat. Stir-fry pork until browned. Remove and set aside."
    },
    {
      "step": 2,
      "instruction": "Add 15 ml of oil to the wok. Cook chicken undisturbed for 2–3 minutes, then stir-fry until browned. Remove and set aside."
    },
    {
      "step": 3,
      "instruction": "In the remaining fat, cook onion with a pinch of salt over medium heat until soft and browned. Add garlic and cook for 30–45 seconds until fragrant. Stir in achiote powder if using. Remove and set aside."
    },
    {
      "step": 4,
      "instruction": "Add remaining 15 ml of oil and increase heat to high. Stir-fry carrots, celery, sugar snap peas, and cabbage with a pinch of salt for about 90 seconds. Remove and set aside."
    },
    {
      "step": 5,
      "instruction": "Add oyster sauce, sugar, soy sauce, fish sauce, and chicken stock to the wok. Bring to a simmer."
    },
    {
      "step": 6,
      "instruction": "Add noodles and stir until the liquid is absorbed and noodles are tender, about 3–4 minutes."
    },
    {
      "step": 7,
      "instruction": "Return all cooked meat and vegetables to the wok. Toss to combine and heat through."
    },
    {
      "step": 8,
      "instruction": "Garnish with lemon juice and serve immediately."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "For a more colourful dish, add capsicum or snow peas. Adjust seasoning with soy sauce or fish sauce to taste. Serve immediately for the best texture."
    }
