  "method": [
    {
      "step": 1,
      "instruction": "Heat 30 ml oil in a wok over medium-high. Stir-fry pork until browned. Set aside."
    },
    {
      "step": 2,
      "instruction": "Add 15 ml oil. Cook chicken undisturbed for 2 to 3 min, then stir-fry until browned. Set aside."
    },
    {
      "step": 3,
      "instruction": "In leftover fat, cook onion with a pinch of salt over medium heat until soft and browned. Add garlic for 30 to 45 sec until fragrant. Stir in achiote if using. Set aside."
    },
    {
      "step": 4,
      "instruction": "Add remaining 15 ml oil, increase heat to high. Stir-fry carrots, celery, peas, and cabbage with a pinch of salt for about 90 sec. Set aside."
    },
    {
      "step": 5,
      "instruction": "Add oyster sauce, sugar, soy sauce, fish sauce, and chicken stock to wok. Bring to a simmer."
    },
    {
      "step": 6,
      "instruction": "Add noodles and stir until liquid is absorbed and noodles are tender (3 to 4 min)."
    },
    {
      "step": 7,
      "instruction": "Return all cooked meat and vegetables to the wok. Toss to combine."
    },
    {
      "step": 8,
      "instruction": "Garnish with lemon or lime juice and green onions."
    }
  ],
  "notes": [
    {
      "title": "Notes / Serving Tip",
      "content": "For a more colourful dish, add bell peppers or snow peas. Adjust seasoning with soy or fish sauce to taste. Serve immediately for the best texture."
