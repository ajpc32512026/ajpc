  "method": [
    {
      "step": 1,
      "instruction": "Grill or pan-fry steaks to desired doneness. Rest."
    },
    {
      "step": 2,
      "instruction": "Melt butter in a saucepan. Add flour and cook roux for 1 minute."
    },
    {
      "step": 3,
      "instruction": "Add warm milk gradually, whisking constantly until smooth and thickened."
    },
    {
      "step": 4,
      "instruction": "Remove from heat. Add grated cheese and stir through. Season with salt, white pepper and nutmeg."
    },
    {
      "step": 5,
      "instruction": "Fold seafood into Mornay sauce and warm through gently — do not boil."
    },
    {
      "step": 6,
      "instruction": "Plate steak and spoon seafood Mornay generously over the top."
