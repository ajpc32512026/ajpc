  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 175°C. Grease and line a loaf tin."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, mix mashed bananas, butter, brown sugar, egg, and vanilla until well combined."
    },
    {
      "step": 3,
      "instruction": "Sprinkle over baking soda and salt, then gently fold in flour until just combined."
    },
    {
      "step": 4,
      "instruction": "Fold through walnuts if using, taking care not to overmix."
    },
    {
      "step": 5,
      "instruction": "Pour batter into prepared tin and smooth the top."
    },
    {
      "step": 6,
      "instruction": "Bake for 50–60 minutes, or until a skewer inserted into the centre comes out clean."
    }
  ],
  "notes": [
    {
      "type": "serving",
      "title": "Serving Tip",
      "content": "Slice thick, toast lightly, and spread with proper butter while still warm."
    },
    {
      "type": "variation",
      "title": "Variations",
      "content": "Walnuts can be replaced with dark chocolate chips or omitted entirely for a plain loaf."
