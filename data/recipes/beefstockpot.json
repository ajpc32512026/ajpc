  "method": [
    {
      "step": 1,
      "instruction": "In a large pot over high heat, add olive oil. Cook onion, carrot, celery, and garlic for 3–4 minutes until softened and fragrant."
    },
    {
      "step": 2,
      "instruction": "Add mushrooms, thyme, oregano, tomato paste, and brown sugar. Stir well and cook for 2 minutes until the paste darkens slightly."
    },
    {
      "step": 3,
      "instruction": "Pour in the red wine and bring to a boil. Let it reduce by half, about 3–4 minutes."
    },
    {
      "step": 4,
      "instruction": "Add beef stock, bring to a simmer, and cook for 10 minutes. Season with salt to taste."
    },
    {
      "step": 5,
      "instruction": "While the stock simmers, mash the plain flour and unsalted butter together to form a smooth paste (beurre manié)."
    },
    {
      "step": 6,
      "instruction": "Whisk the butter-flour paste into the simmering stock to thicken. Continue simmering for 2–3 minutes until the sauce coats the back of a spoon."
    },
    {
      "step": 7,
      "instruction": "In a separate hot pan with a little oil, sear the diced scotch fillet over high heat until browned on all sides but still medium-rare in the centre, about 2–3 minutes."
    },
    {
      "step": 8,
      "instruction": "Add the seared beef to the sauce, stir gently, and serve immediately over mashed potatoes, polenta, or buttered pasta."
    }
  ],
  "notes": [
    {
      "type": "tip",
      "title": "Wine Substitute",
      "content": "If you prefer not to use wine, substitute with additional beef stock plus 1 tablespoon of balsamic vinegar for depth."
    },
    {
      "type": "technique",
      "title": "Beurre Manié",
      "content": "This butter-flour paste is a French technique for thickening sauces without lumps. Mix it thoroughly before whisking into hot liquid."
    },
    {
      "type": "technique",
      "title": "Why Scotch Fillet",
      "content": "Scotch fillet is ideal for this recipe because it stays tender during quick, high-heat searing. Tougher cuts like chuck or brisket need long slow braising and won't work in a 20-minute stock pot. If substituting, use rib-eye or sirloin — anything with good marbling that can be served medium-rare."
    }
  ],
