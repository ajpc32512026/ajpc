  "method": [
    {
      "step": 1,
      "instruction": "Pan-fry veal briefly — just seared, not fully cooked as it will finish in the oven."
    },
    {
      "step": 2,
      "instruction": "Fry bacon and shallots in butter until softened. Add mushrooms and cook until golden."
    },
    {
      "step": 3,
      "instruction": "Add a little demi glace to the mushroom mix to bind it slightly."
    },
    {
      "step": 4,
      "instruction": "Wrap each veal steak with the mushroom and bacon mix in puff pastry. Seal well with egg wash."
    },
    {
      "step": 5,
      "instruction": "Brush the top with egg wash. Bake at 200°C until pastry is golden."
    },
    {
      "step": 6,
      "instruction": "Add mozzarella on top in the last few minutes of baking until melted."
    }
  ],
