{
  "id": "lamington",
  "title": "Classic Lamingtons",
  "emoji": "🧁",
  "category": "Dinner",
  "description": "Aussie pride in a cake cube — but built properly, with a real sponge that can hold its own.",
  "ingredients": [
    {
      "quantity": "4",
      "unit": "large",
      "item": "Eggs",
      "ingredientKey": "Eggs"
    },
    {
      "quantity": "1",
      "unit": "cup",
      "item": "Sugar",
      "ingredientKey": "Sugar"
    },
    {
      "quantity": "1",
      "unit": "tsp",
      "item": "Vanilla",
      "ingredientKey": "Vanilla"
    },
    {
      "quantity": "1/2",
      "unit": "cup",
      "item": "Flour",
      "ingredientKey": "Flour"
    },
    {
      "quantity": "1/2",
      "unit": "tsp",
      "item": "Baking Powder",
      "ingredientKey": "Baking Powder"
    },
    {
      "quantity": "1/2",
      "unit": "cup",
      "item": "Milk",
      "ingredientKey": "Milk"
    },
    {
      "quantity": "60",
      "unit": "g",
      "item": "Butter",
      "ingredientKey": "Butter"
    },
    {
      "quantity": "3",
      "unit": "cups",
      "item": "Sugar",
      "ingredientKey": "Sugar"
    },
    {
      "quantity": "1/3",
      "unit": "cup",
      "item": "Cocoa Powder",
      "ingredientKey": "Cocoa Powder"
    },
    {
      "quantity": "3/4",
      "unit": "cup",
      "item": "boiling water"
    },
    {
      "quantity": "1",
      "unit": "tbsp",
      "item": "Butter",
      "ingredientKey": "Butter"
    },
    {
      "quantity": "2",
      "unit": "cups",
      "item": "Coconut",
      "ingredientKey": "Coconut"
    }
  ],
  "method": [
    {
      "step": "1",
      "instruction": "Preheat oven to 180°C (350°F). Line a 20×30 cm / 9×13\" slab pan with baking paper."
    },
    {
      "step": "2",
      "instruction": "Beat eggs and sugar on high for 6–8 minutes until pale, thick, and tripled in volume."
    },
    {
      "step": "3",
      "instruction": "Stir in vanilla extract."
    },
    {
      "step": "4",
      "instruction": "Sift flour and baking powder together, then fold into egg mixture gently in three batches."
    },
    {
      "step": "5",
      "instruction": "Heat milk and butter until melted and warm. Mix in a scoop of batter, then fold back into the main bowl."
    },
    {
      "step": "6",
      "instruction": "Pour into the pan and bake 22–25 minutes or until a skewer comes out clean."
    },
    {
      "step": "7",
      "instruction": "Cool completely on a rack. Chill or freeze briefly for easier cutting."
    },
    {
      "step": "8",
      "instruction": "Sift icing sugar and cocoa into a bowl."
    },
    {
      "step": "9",
      "instruction": "Add boiling water and butter."
    },
    {
      "step": "10",
      "instruction": "Whisk until smooth. Keep warm while using."
    },
    {
      "step": "11",
      "instruction": "Cut the sponge into 4–5 cm squares."
    },
    {
      "step": "12",
      "instruction": "Dip each piece in the warm chocolate icing, letting excess drip off."
    },
    {
      "step": "13",
      "instruction": "Roll in coconut until fully coated."
    },
    {
      "step": "14",
      "instruction": "Set on a rack to firm up."
    }
  ],
  "notes": [
    {
      "title": "Tip",
      "content": "Split and fill with jam and whipped cream for the deluxe bakery-style Lamington."
    },
