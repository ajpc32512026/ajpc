    "method": [
        {
            "step": 1,
            "instruction": "Cook potatoes in a pan of boiling water for 15–20 minutes until tender. Drain thoroughly and mash until smooth. Allow to cool slightly."
        },
        {
            "step": 2,
            "instruction": "Add flour, Parmesan, melted butter, salt, and pepper to the mashed potatoes. Using a flat-bladed knife, mix with a cutting motion to form a firm dough."
        },
        {
            "step": 3,
            "instruction": "Knead briefly on a lightly floured surface until smooth. Do not over-handle or the gnocchi will be tough."
        },
        {
            "step": 4,
            "instruction": "Roll heaped teaspoons of dough into oval shapes and indent one side with the back of a fork."
        },
        {
            "step": 5,
            "instruction": "Cook gnocchi in batches in rapidly boiling salted water for 3–5 minutes. When they float, they are cooked. Drain well and keep warm."
        },
        {
            "step": 6,
            "instruction": "For the sauce: combine tomatoes, garlic, wine, basil, salt, and pepper in a pan. Bring to the boil, then reduce heat and simmer gently for 15–20 minutes, stirring occasionally, until slightly thickened."
        },
        {
            "step": 7,
            "instruction": "Serve gnocchi in warmed bowls with tomato sauce and extra grated Parmesan."
        }
    ],
    "notes": [
        {
            "type": "technique",
            "title": "Basil Tip",
            "content": "Fresh basil should be added at the end of cooking to preserve its flavour. Chop or tear just before using to prevent blackening."
        },
