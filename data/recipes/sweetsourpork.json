    "method": [
        {
            "step": 1,
            "instruction": "In a bowl, marinate pork with soy sauce, white pepper, and five spice. Let sit for 15–20 minutes."
        },
        {
            "step": 2,
            "instruction": "Combine plain flour and cornflour in a bowl. Beat the egg in a separate bowl."
        },
        {
            "step": 3,
            "instruction": "Dip each piece of marinated pork in beaten egg, then coat thoroughly in the flour mixture."
        },
        {
            "step": 4,
            "instruction": "Heat oil for deep frying to 170–180°C. Fry pork in batches until golden and crispy, about 5–6 minutes per batch. Drain on paper towels."
        },
        {
            "step": 5,
            "instruction": "For the sauce: mix together tomato sauce, brown sugar, and white vinegar in a small bowl. Set aside."
        },
        {
            "step": 6,
            "instruction": "Heat vegetable oil in a wok or large frying pan over high heat. Stir-fry onion and capsicum for 2–3 minutes until slightly softened but still crisp."
        },
        {
            "step": 7,
            "instruction": "Add garlic and carrot. Stir-fry for 30 seconds until fragrant."
        },
        {
            "step": 8,
            "instruction": "Pour in the sauce mixture. Bring to a simmer and cook for 2–3 minutes until slightly thickened."
        },
        {
            "step": 9,
            "instruction": "Add crispy pork pieces and toss quickly to coat in the sauce. Serve immediately over steamed rice."
        }
    ],
    "notes": [
        {
            "type": "technique",
            "title": "Keep It Crispy",
            "content": "Add the pork to the sauce at the very last moment and serve immediately. The longer it sits in the sauce, the softer the coating becomes."
        },
        {
            "type": "technique",
            "title": "Double Fry",
            "content": "For extra crispy pork, fry once at 160°C, let rest for 5 minutes, then fry again at 180°C until golden."
        },
        {
            "type": "variation",
            "title": "Add Pineapple",
            "content": "Fresh or canned pineapple chunks add authentic sweetness and texture. Add them with the vegetables in step 6."
        }
    ],
