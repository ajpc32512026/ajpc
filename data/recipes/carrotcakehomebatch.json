  "method": [
    {
      "step": 1,
      "instruction": "Preheat oven to 150°C. Grease and line a 20 cm × 5 cm round cake tin."
    },
    {
      "step": 2,
      "instruction": "In a large bowl, beat eggs, sugar, flour, vanilla, oil, baking powder, salt, and cinnamon until smooth."
    },
    {
      "step": 3,
      "instruction": "Fold in grated carrots, sultanas, and ground walnuts evenly."
    },
    {
      "step": 4,
      "instruction": "Pour batter into prepared tin and level the surface."
    },
    {
      "step": 5,
      "instruction": "Place a deep tray of hot water on the lower oven rack to maintain moisture."
    },
    {
      "step": 6,
      "instruction": "Bake for 1 hour, checking with a wooden skewer for doneness."
    },
    {
      "step": 7,
      "instruction": "Cool in the tin for 10 minutes, then turn out onto a wire rack and cool completely before slicing."
    }
  ],
